*.py[cod]
*$py.class
.mypy_cache/
.pytest_cache/
.ruff_cache/
.cache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution and build output
build/
dist/
output/
*.egg-info/
.eggs/
wheels/
sdist/

# Test and coverage output
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/

# Logs
*.log
logs/
src/file_tagger/logs/

